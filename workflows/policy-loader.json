{
  "name": "Policy Loader",
  "nodes": [
    {
      "parameters": {
        "events": [
          "init"
        ]
      },
      "id": "d0000000-0000-4000-8000-000000000001",
      "name": "When n8n Starts",
      "type": "n8n-nodes-base.n8nTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "d0000000-0000-4000-8000-000000000002",
      "name": "Every Morning 7 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {},
      "id": "d0000000-0000-4000-8000-000000000003",
      "name": "Reload Now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        320
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_ID",
            "mode": "id"
          },
          "whatToSearch": "files"
        },
        "options": {}
      },
      "id": "d0000000-0000-4000-8000-000000000004",
      "name": "List Policy Files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        260,
        160
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "id": "d0000000-0000-4000-8000-000000000005",
      "name": "Download Policy",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        500,
        160
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "value": "hr_policies",
          "mode": "list",
          "cachedResultName": "hr_policies"
        },
        "clearStore": true
      },
      "id": "d0000000-0000-4000-8000-000000000006",
      "name": "Reload Knowledge Base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        740,
        160
      ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "options": {}
      },
      "id": "d0000000-0000-4000-8000-000000000007",
      "name": "Read Policy Text",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [
        820,
        380
      ]
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 200,
        "options": {}
      },
      "id": "d0000000-0000-4000-8000-000000000008",
      "name": "Split Into Chunks",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        820,
        560
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "id": "c0000000-0000-4000-8000-000000000009",
      "name": "Gemini Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        680,
        380
      ]
    }
  ],
  "connections": {
    "When n8n Starts": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Morning 7 AM": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reload Now": {
      "main": [
        [
          {
            "node": "List Policy Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Policy Files": {
      "main": [
        [
          {
            "node": "Download Policy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Policy": {
      "main": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Policy Text": {
      "ai_document": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Split Into Chunks": {
      "ai_textSplitter": [
        [
          {
            "node": "Read Policy Text",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Reload Knowledge Base",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}